# ATTOM Property Data API — sign up at https://api.attomdata.com
ATTOM_API_KEY=

# API Key (optional) — set to require X-API-Key header on /api/* routes
API_KEY=

# MongoDB (optional, defaults to localhost:27017)
MDB_CONNECTION_STRING=mongodb://localhost:27017

# Discord (optional, for Grafana alerts)
DISCORD_WEBHOOK_URL=

# Groq (optional, for Graphify semantic extraction)
GROQ_API_KEY=
